#!/bin/sh
#
# PROVIDE: nclink_proxy
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#

. /etc/rc.subr

name=nclink_proxy
rcvar=nclink_proxy_enable
command=/usr/sbin/daemon
pidfile="/var/run/${name}.pid"

load_rc_config $name

: ${nclink_proxy_enable:=NO}
: ${nclink_proxy_pidfile:=${pidfile}}

pidfile="${nclink_proxy_pidfile}"
command_args="-f -p ${pidfile} /usr/local/opnsense/scripts/nclink/proxy.py ${nclink_proxy_flags}"

run_rc_command "$1"
