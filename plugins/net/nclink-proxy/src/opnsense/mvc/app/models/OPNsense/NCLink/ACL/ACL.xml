<acl>
    <page-nclink-proxy>
        <name>Services: NC-Link Proxy</name>
        <description>Allow access to the NC-Link proxy service</description>
        <patterns>
            <pattern>ui/nclink/proxy</pattern>
            <pattern>api/nclink/settings/*</pattern>
            <pattern>api/nclink/service/*</pattern>
            <pattern>api/nclink/log/*</pattern>
        </patterns>
    </page-nclink-proxy>
</acl>
