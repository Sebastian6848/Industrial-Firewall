<model>
    <mount>//OPNsense/NCLink</mount>
    <version>1.0.0</version>
    <description>NC-Link proxy</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </enabled>
            <listen_host type="HostnameField">
                <Required>Y</Required>
                <Default>127.0.0.1</Default>
            </listen_host>
            <listen_port type="PortField">
                <Required>Y</Required>
                <Default>11883</Default>
            </listen_port>
            <target_host type="HostnameField">
                <Required>N</Required>
            </target_host>
            <target_port type="PortField">
                <Required>Y</Required>
                <Default>1883</Default>
            </target_port>
            <log_file type="TextField">
                <Required>Y</Required>
                <Default>/var/log/nclink-proxy.log</Default>
                <Mask>/^\/var\/log\/[0-9A-Za-z][0-9A-Za-z._-]{0,199}\.log$/u</Mask>
                <ValidationMessage>Please specify a log file below /var/log with a .log suffix.</ValidationMessage>
            </log_file>
        </general>
    </items>
</model>
