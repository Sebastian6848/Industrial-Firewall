#!/bin/sh
# PROVIDE: industrial_suite
# REQUIRE: LOGIN
# KEYWORD: shutdown
. /etc/rc.subr
name=industrial_suite
rcvar=industrial_suite_enable
load_rc_config "$name"
: ${industrial_suite_enable:="YES"}
pidfile=/var/run/industrial_suite.pid
command=/usr/sbin/daemon
command_args="-f -p ${pidfile} /usr/local/bin/python3 /usr/local/opnsense/scripts/industrialsuite/suite.py watch"
procname=/usr/local/bin/python3
run_rc_command "$1"
